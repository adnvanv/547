@page
@model FitnessStudio.Web.Pages.Classes.IndexModel
@{
    ViewData["Title"] = "Classes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Weekly class schedule</h1>
    <a asp-page="Edit" class="btn btn-@S.Accent">+ Add class</a>
</div>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>ID</th>
                <th>Class</th>
                <th>Day</th>
                <th>Start</th>
                <th>Length</th>
                <th>Instructor</th>
                <th>Room</th>
                <th>Capacity</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model.Classes)
            {
                <tr>
                    <td>@c.ClassId</td>
                    <td>@c.Title</td>
                    <td>@c.DayOfWeek</td>
                    <td>@S.FormatTime(c.StartTime)</td>
                    <td>@c.DurationMinutes min</td>
                    <td>@c.Instructor?.FullName</td>
                    <td>@c.Room</td>
                    <td>@c.Capacity</td>
                    <td class="actions">
                        <a asp-page="Edit" asp-route-id="@c.ClassId" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <partial name="_DeleteButton" model="@(("Delete", c.ClassId))" />
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
