@page "{id:int}"
@model FitnessStudio.Web.Pages.Classes.DeleteModel
@{
    ViewData["Title"] = "Delete class";
    var c = Model.FitnessClass;
}

<h1>Delete class</h1>

<div class="card border-danger" style="max-width: 40rem">
    <div class="card-body">
        <p class="fw-semibold">Are you sure you want to delete this class?</p>
        <dl class="row mb-0">
            <dt class="col-sm-4">ID</dt><dd class="col-sm-8">@c.ClassId</dd>
            <dt class="col-sm-4">Class</dt><dd class="col-sm-8">@c.Title</dd>
            <dt class="col-sm-4">When</dt><dd class="col-sm-8">@c.DayOfWeek at @S.FormatTime(c.StartTime) (@c.DurationMinutes min)</dd>
            <dt class="col-sm-4">Instructor</dt><dd class="col-sm-8">@c.Instructor?.FullName</dd>
            <dt class="col-sm-4">Room</dt><dd class="col-sm-8">@c.Room</dd>
        </dl>
        <form method="post" class="mt-3">
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>
