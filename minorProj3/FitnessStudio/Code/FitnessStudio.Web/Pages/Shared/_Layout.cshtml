<!DOCTYPE html>
<html lang="en" data-bs-theme="@(S.Theme == "dark" ? "dark" : "light")" data-theme-setting="@S.Theme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Fitness Studio</title>
    @if (S.Theme == "auto")
    {
        <script>
            // "Auto" theme follows the operating system's light/dark preference.
            if (window.matchMedia('(prefers-color-scheme: dark)').matches)
                document.documentElement.setAttribute('data-bs-theme', 'dark');
        </script>
    }
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FitnessStudio.Web.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var page = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
        string Active(string prefix) => page.StartsWith(prefix) ? "active" : "";
    }
    <header>
        <nav class="navbar navbar-expand-md navbar-dark bg-@S.Accent mb-4 shadow-sm" data-bs-theme="dark">
            <div class="container">
                <a class="navbar-brand fw-semibold" asp-page="/Index">&#127947; Fitness Studio</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link @(page == "/Index" ? "active" : "")" asp-page="/Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link @Active("/Members")" asp-page="/Members/Index">Members</a></li>
                        <li class="nav-item"><a class="nav-link @Active("/Instructors")" asp-page="/Instructors/Index">Instructors</a></li>
                        <li class="nav-item"><a class="nav-link @Active("/Classes")" asp-page="/Classes/Index">Classes</a></li>
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link @Active("/Admin")" asp-page="/Admin/Index">
                                Administration
                                @if (S.AdminMode)
                                {
                                    <span class="badge text-bg-light ms-1">Admin mode</span>
                                }
                            </a>
                        </li>
                        <li class="nav-item"><a class="nav-link @Active("/Settings")" asp-page="/Settings">Settings</a></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @if (TempData["StatusMessage"] is string status)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @status
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] is string error)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @error
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-body-secondary">
        <div class="container">
            &copy; 2026 Fitness Studio &middot; Minor Project 3
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
