@page "{id:int}"
@model FitnessStudio.Web.Pages.Instructors.DeleteModel
@{
    ViewData["Title"] = "Delete instructor";
    var i = Model.Instructor;
}

<h1>Delete instructor</h1>

<div class="card border-danger" style="max-width: 40rem">
    <div class="card-body">
        <p class="fw-semibold">Are you sure you want to delete this instructor?</p>
        @if (i.Classes.Count > 0)
        {
            <div class="alert alert-warning">
                @i.FullName teaches @i.Classes.Count class(es). Reassign or delete those classes first,
                or the delete will be refused.
            </div>
        }
        <dl class="row mb-0">
            <dt class="col-sm-4">ID</dt><dd class="col-sm-8">@i.InstructorId</dd>
            <dt class="col-sm-4">Name</dt><dd class="col-sm-8">@i.FullName</dd>
            <dt class="col-sm-4">Email</dt><dd class="col-sm-8">@i.Email</dd>
            <dt class="col-sm-4">Specialty</dt><dd class="col-sm-8">@i.Specialty</dd>
            <dt class="col-sm-4">Hired</dt><dd class="col-sm-8">@S.FormatDate(i.HireDate)</dd>
        </dl>
        <form method="post" class="mt-3">
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>
