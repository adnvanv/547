@page "{id:int}"
@model FitnessStudio.Web.Pages.Members.DeleteModel
@{
    ViewData["Title"] = "Delete member";
    var m = Model.Member;
}

<h1>Delete member</h1>

<div class="card border-danger" style="max-width: 40rem">
    <div class="card-body">
        <p class="fw-semibold">Are you sure you want to delete this member?</p>
        <dl class="row mb-0">
            <dt class="col-sm-4">ID</dt><dd class="col-sm-8">@m.MemberId</dd>
            <dt class="col-sm-4">Name</dt><dd class="col-sm-8">@m.FullName</dd>
            <dt class="col-sm-4">Email</dt><dd class="col-sm-8">@m.Email</dd>
            <dt class="col-sm-4">Phone</dt><dd class="col-sm-8">@m.Phone</dd>
            <dt class="col-sm-4">Plan</dt><dd class="col-sm-8">@m.Plan?.Name</dd>
            <dt class="col-sm-4">Joined</dt><dd class="col-sm-8">@S.FormatDate(m.JoinDate)</dd>
        </dl>
        <form method="post" class="mt-3">
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>
