@page "{id:int?}"
@model FitnessStudio.Web.Pages.Admin.EditModel
@{
    ViewData["Title"] = Model.IsNew ? "Add membership plan" : "Edit membership plan";
}

<h1>@ViewData["Title"]</h1>

<form method="post" class="card" style="max-width: 40rem">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <input type="hidden" asp-for="Plan.PlanId" />

        @if (!Model.IsNew)
        {
            <p class="text-body-secondary">Plan ID: @Model.Plan.PlanId</p>
        }

        <div class="row g-3">
            <div class="col-sm-7">
                <label asp-for="Plan.Name" class="form-label"></label>
                <input asp-for="Plan.Name" class="form-control" />
                <span asp-validation-for="Plan.Name" class="text-danger"></span>
            </div>
            <div class="col-sm-5">
                <label asp-for="Plan.MonthlyPrice" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input asp-for="Plan.MonthlyPrice" class="form-control" type="number" step="0.01" min="0" />
                </div>
                <span asp-validation-for="Plan.MonthlyPrice" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="Plan.Description" class="form-label"></label>
                <textarea asp-for="Plan.Description" class="form-control" rows="2"></textarea>
                <span asp-validation-for="Plan.Description" class="text-danger"></span>
            </div>
            <div class="col-12">
                <div class="form-check form-switch">
                    <input asp-for="Plan.IsActive" class="form-check-input" />
                    <label asp-for="Plan.IsActive" class="form-check-label">Active (offered to new members)</label>
                </div>
            </div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-@S.Accent">@(Model.IsNew ? "Add plan" : "Save changes")</button>
            <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
