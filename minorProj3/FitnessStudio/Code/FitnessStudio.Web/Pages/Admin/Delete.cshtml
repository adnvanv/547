@page "{id:int}"
@model FitnessStudio.Web.Pages.Admin.DeleteModel
@{
    ViewData["Title"] = "Delete membership plan";
    var p = Model.Plan;
}

<h1>Delete membership plan</h1>

<div class="card border-danger" style="max-width: 40rem">
    <div class="card-body">
        <p class="fw-semibold">Are you sure you want to delete this plan?</p>
        @if (p.Members.Count > 0)
        {
            <div class="alert alert-warning">
                @p.Members.Count member(s) are on this plan, so the delete will be refused.
                Move them to another plan or mark this plan inactive instead.
            </div>
        }
        <dl class="row mb-0">
            <dt class="col-sm-4">ID</dt><dd class="col-sm-8">@p.PlanId</dd>
            <dt class="col-sm-4">Plan</dt><dd class="col-sm-8">@p.Name</dd>
            <dt class="col-sm-4">Monthly price</dt><dd class="col-sm-8">@p.MonthlyPrice.ToString("C")</dd>
            <dt class="col-sm-4">Description</dt><dd class="col-sm-8">@p.Description</dd>
        </dl>
        <form method="post" class="mt-3">
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>
