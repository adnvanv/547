@model List<Reservation>
@{
    ViewData["Title"] = S.T("Reservations");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">@S.T("Reservations")</h1>
    <a asp-action="Edit" class="btn btn-@S.Accent">+ @S.T("New reservation")</a>
</div>
<p class="text-body-secondary">
    @Model.Count @S.T("reservations").
    @if (!S.ShowCancelled)
    {
        @S.T("Cancelled reservations are hidden (see Settings).")
    }
</p>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>#</th>
                <th>@S.T("Guest")</th>
                <th>@S.T("Room")</th>
                <th>@S.T("Check-in")</th>
                <th>@S.T("Check-out")</th>
                <th>@S.T("Nights")</th>
                <th>@S.T("Guests")</th>
                <th>@S.T("Status")</th>
                <th class="text-end">@S.T("Total")</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>@r.ReservationId</td>
                    <td><a asp-controller="Guests" asp-action="Details" asp-route-id="@r.GuestId">@r.GuestName</a></td>
                    <td>@r.RoomNumber <span class="text-body-secondary small">@r.RoomTypeName</span></td>
                    <td>@S.FormatDate(r.CheckInDate)</td>
                    <td>@S.FormatDate(r.CheckOutDate)</td>
                    <td>@r.Nights</td>
                    <td>@r.NumberOfGuests</td>
                    <td><partial name="_StatusBadge" model="r.Status" /></td>
                    <td class="text-end">@r.TotalCost.ToString("C")</td>
                    <td class="actions">
                        <a asp-action="Edit" asp-route-id="@r.ReservationId" class="btn btn-sm btn-outline-secondary">@S.T("Edit")</a>
                        <partial name="_DeleteButton" model="r.ReservationId" />
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
