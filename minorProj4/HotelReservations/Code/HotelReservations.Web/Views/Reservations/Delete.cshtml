@model Reservation
@{
    ViewData["Title"] = S.T("Delete reservation");
}

<h1>@ViewData["Title"]</h1>

<div class="card border-danger" style="max-width: 40rem">
    <div class="card-body">
        <p class="fw-semibold">@S.T("Are you sure you want to delete this reservation?")</p>
        <dl class="row mb-0">
            <dt class="col-sm-4">#</dt><dd class="col-sm-8">@Model.ReservationId</dd>
            <dt class="col-sm-4">@S.T("Guest")</dt><dd class="col-sm-8">@Model.GuestName</dd>
            <dt class="col-sm-4">@S.T("Room")</dt><dd class="col-sm-8">@Model.RoomNumber (@Model.RoomTypeName)</dd>
            <dt class="col-sm-4">@S.T("Dates")</dt><dd class="col-sm-8">@S.FormatDate(Model.CheckInDate) &rarr; @S.FormatDate(Model.CheckOutDate)</dd>
            <dt class="col-sm-4">@S.T("Status")</dt><dd class="col-sm-8"><partial name="_StatusBadge" model="Model.Status" /></dd>
            <dt class="col-sm-4">@S.T("Total")</dt><dd class="col-sm-8">@Model.TotalCost.ToString("C")</dd>
        </dl>
        <p class="small text-body-secondary mt-3 mb-0">@S.T("Tip: to keep a record of the booking, edit it and set the status to Cancelled instead.")</p>
        <form method="post" asp-action="Delete" asp-route-id="@Model.ReservationId" class="mt-3">
            <button type="submit" class="btn btn-danger">@S.T("Delete")</button>
            <a asp-action="Index" class="btn btn-outline-secondary">@S.T("Cancel")</a>
        </form>
    </div>
</div>
