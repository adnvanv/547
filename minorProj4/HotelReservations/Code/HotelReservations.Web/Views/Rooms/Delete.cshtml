@model Room
@{
    ViewData["Title"] = S.T("Delete room");
}

<h1>@ViewData["Title"]</h1>

<div class="card border-danger" style="max-width: 40rem">
    <div class="card-body">
        <p class="fw-semibold">@S.T("Are you sure you want to delete this room?")</p>
        <dl class="row mb-0">
            <dt class="col-sm-4">ID</dt><dd class="col-sm-8">@Model.RoomId</dd>
            <dt class="col-sm-4">@S.T("Room")</dt><dd class="col-sm-8">@Model.RoomNumber (@S.T("Floor") @Model.Floor)</dd>
            <dt class="col-sm-4">@S.T("Room type")</dt><dd class="col-sm-8">@Model.RoomTypeName</dd>
            <dt class="col-sm-4">@S.T("Reservations")</dt><dd class="col-sm-8">@Model.ReservationCount</dd>
        </dl>
        @if (Model.ReservationCount > 0)
        {
            <div class="alert alert-warning mt-3 mb-0">
                @S.T("This room has reservations, so the database will block the delete. Consider marking it out of service instead.")
            </div>
        }
        <form method="post" asp-action="Delete" asp-route-id="@Model.RoomId" class="mt-3">
            <button type="submit" class="btn btn-danger">@S.T("Delete")</button>
            <a asp-action="Index" class="btn btn-outline-secondary">@S.T("Cancel")</a>
        </form>
    </div>
</div>
