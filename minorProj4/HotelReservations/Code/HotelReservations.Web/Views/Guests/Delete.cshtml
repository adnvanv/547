@model Guest
@{
    ViewData["Title"] = S.T("Delete guest");
}

<h1>@ViewData["Title"]</h1>

<div class="card border-danger" style="max-width: 40rem">
    <div class="card-body">
        <p class="fw-semibold">@S.T("Are you sure you want to delete this guest?")</p>
        <dl class="row mb-0">
            <dt class="col-sm-4">ID</dt><dd class="col-sm-8">@Model.GuestId</dd>
            <dt class="col-sm-4">@S.T("Name")</dt><dd class="col-sm-8">@Model.FullName</dd>
            <dt class="col-sm-4">@S.T("Email")</dt><dd class="col-sm-8">@Model.Email</dd>
            <dt class="col-sm-4">@S.T("Phone")</dt><dd class="col-sm-8">@Model.Phone</dd>
            <dt class="col-sm-4">@S.T("City")</dt><dd class="col-sm-8">@Model.City, @Model.Country</dd>
            <dt class="col-sm-4">@S.T("Reservations")</dt><dd class="col-sm-8">@Model.ReservationCount</dd>
        </dl>
        @if (Model.ReservationCount > 0)
        {
            <div class="alert alert-warning mt-3 mb-0">
                @S.T("This guest has reservations, so the database will block the delete until they are removed.")
            </div>
        }
        <form method="post" asp-action="Delete" asp-route-id="@Model.GuestId" class="mt-3">
            <button type="submit" class="btn btn-danger">@S.T("Delete")</button>
            <a asp-action="Index" class="btn btn-outline-secondary">@S.T("Cancel")</a>
        </form>
    </div>
</div>
