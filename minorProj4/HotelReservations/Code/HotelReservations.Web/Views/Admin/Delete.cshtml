@model RoomType
@{
    ViewData["Title"] = S.T("Delete room type");
}

<h1>@ViewData["Title"]</h1>

<div class="card border-danger" style="max-width: 40rem">
    <div class="card-body">
        <p class="fw-semibold">@S.T("Are you sure you want to delete this room type?")</p>
        <dl class="row mb-0">
            <dt class="col-sm-4">ID</dt><dd class="col-sm-8">@Model.RoomTypeId</dd>
            <dt class="col-sm-4">@S.T("Name")</dt><dd class="col-sm-8">@Model.Name</dd>
            <dt class="col-sm-4">@S.T("Nightly rate")</dt><dd class="col-sm-8">@Model.NightlyRate.ToString("C")</dd>
            <dt class="col-sm-4">@S.T("Rooms")</dt><dd class="col-sm-8">@Model.RoomCount</dd>
        </dl>
        @if (Model.RoomCount > 0)
        {
            <div class="alert alert-warning mt-3 mb-0">
                @S.T("Rooms still use this type, so the database will block the delete. Mark it inactive instead.")
            </div>
        }
        <form method="post" asp-action="Delete" asp-route-id="@Model.RoomTypeId" class="mt-3">
            <button type="submit" class="btn btn-danger">@S.T("Delete")</button>
            <a asp-action="Index" class="btn btn-outline-secondary">@S.T("Cancel")</a>
        </form>
    </div>
</div>
