<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StayPlanner.Desktop.App"
             RequestedThemeVariant="Light">
  <Application.Styles>
    <!-- Fixed accent so the app looks the same on every OS instead of following the Windows accent color. -->
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#2E5A8A" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#5F6B7A" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#DDE3EA" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16" />
    </Style>
  </Application.Styles>
</Application>
