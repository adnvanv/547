<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:StayPlanner.Desktop.ViewModels"
        mc:Ignorable="d"
        x:Class="StayPlanner.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Stay Planner"
        Width="1180" Height="800" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6F9">

  <DockPanel>
    <!-- Header -->
    <Border DockPanel.Dock="Top" Background="#1F3A5F" Padding="20,14">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Text="Stay Planner" FontSize="22" FontWeight="Bold" Foreground="White" />
          <TextBlock Text="Hotel room quotes and bookings · Avalonia desktop client" Foreground="#C9D6E6" />
        </StackPanel>
        <Border Grid.Column="1" Background="#2E5A8A" CornerRadius="14" Padding="12,6" VerticalAlignment="Center">
          <TextBlock Foreground="White" FontWeight="SemiBold">
            <Run Text="Running on " /><Run Text="{Binding PlatformDescription}" />
          </TextBlock>
        </Border>
      </Grid>
    </Border>

    <!-- Footer -->
    <Border DockPanel.Dock="Bottom" Background="#E7ECF2" Padding="20,6">
      <TextBlock Classes="muted" FontSize="12">
        <Run Text="Reservations file: " /><Run Text="{Binding StoragePath}" />
      </TextBlock>
    </Border>

    <Grid Margin="16" ColumnDefinitions="280,*,340" RowDefinitions="*,220" ColumnSpacing="16" RowSpacing="16">

      <!-- Stay details -->
      <Border Classes="card" Grid.Row="0" Grid.Column="0">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="Your stay" />
          <TextBlock Text="Check-in" />
          <CalendarDatePicker SelectedDate="{Binding CheckIn}" DisplayDateStart="{Binding Today}" HorizontalAlignment="Stretch" />
          <TextBlock Text="Check-out" />
          <CalendarDatePicker SelectedDate="{Binding CheckOut}" DisplayDateStart="{Binding Today}" HorizontalAlignment="Stretch" />
          <TextBlock Text="Guests" />
          <NumericUpDown Value="{Binding Guests}" Minimum="1" Maximum="6" Increment="1" FormatString="0" />
          <TextBlock Text="Guest name" />
          <TextBox Text="{Binding GuestName}" Watermark="e.g. Jordan Lee" />
          <Button Content="Book selected room" Command="{Binding BookCommand}" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center" Classes="accent" Margin="0,6,0,0" />
          <TextBlock Text="{Binding Message}" Foreground="{Binding MessageColor}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- Rooms -->
      <Border Classes="card" Grid.Row="0" Grid.Column="1">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="h2" Text="Rooms for your dates" />
          <ListBox ItemsSource="{Binding Rooms}" SelectedItem="{Binding SelectedRoom}" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:RoomItem">
                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Details}" Classes="muted" FontSize="12" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding Rate}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" HorizontalAlignment="Right" FontSize="12" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- Quote -->
      <Border Classes="card" Grid.Row="0" Grid.Column="2">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="h2" Text="Price quote" />
          <TextBlock DockPanel.Dock="Top" Text="{Binding QuoteHeader}" TextWrapping="Wrap" Margin="0,0,0,10" />
          <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
            <TextBlock Text="Total" FontSize="18" FontWeight="Bold" />
            <TextBlock Grid.Column="1" Text="{Binding QuoteTotal}" FontSize="18" FontWeight="Bold" Foreground="#1F3A5F" />
          </Grid>
          <Separator DockPanel.Dock="Bottom" />
          <ItemsControl ItemsSource="{Binding QuoteLines}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:QuoteLineItem">
                <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                  <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,0,8,0" />
                  <TextBlock Grid.Column="1" Text="{Binding Amount}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>
      </Border>

      <!-- Reservations -->
      <Border Classes="card" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="h2" Text="Reservations" />
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Reservations}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ReservationItem">
                  <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,3">
                    <StackPanel>
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Details}" Classes="muted" FontSize="12" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Total}" VerticalAlignment="Center" Margin="12,0" FontWeight="SemiBold" />
                    <Button Grid.Column="2" Content="Cancel" VerticalAlignment="Center"
                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CancelCommand}"
                            CommandParameter="{Binding Id}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
