<UserControl x:Class="VetClinic.App.Views.PetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <Grid Margin="8,16,8,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="Pets" Style="{StaticResource SectionHeader}" />
            <TextBlock x:Name="ResultCount" DockPanel.Dock="Bottom" Margin="0,6,0,0" Style="{StaticResource Hint}" />
            <DataGrid x:Name="Grid" SelectionChanged="Grid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding PetId}" Width="50" />
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="Species" Binding="{Binding Species}" Width="*" />
                    <DataGridTextColumn Header="Breed" Binding="{Binding Breed}" Width="1.5*" />
                    <DataGridTextColumn Header="Owner" Binding="{Binding OwnerName}" Width="1.5*" />
                    <DataGridTextColumn Header="Born" Binding="{Binding BirthDate, StringFormat=d}" Width="*" />
                    <DataGridTextColumn Header="Weight (kg)" Binding="{Binding WeightKg}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <StackPanel Grid.Column="2">
            <TextBlock x:Name="FormTitle" Text="New pet" Style="{StaticResource SectionHeader}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                    <RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="ID" Style="{StaticResource FormLabel}" />
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="IdBox" IsReadOnly="True" Focusable="False" />
                <TextBlock Grid.Row="1" Text="Owner *" Style="{StaticResource FormLabel}" />
                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="OwnerBox" SelectedValuePath="OwnerId" />
                <TextBlock Grid.Row="2" Text="Name *" Style="{StaticResource FormLabel}" />
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="NameBox" MaxLength="50" />
                <TextBlock Grid.Row="3" Text="Species *" Style="{StaticResource FormLabel}" />
                <ComboBox Grid.Row="3" Grid.Column="1" x:Name="SpeciesBox" IsEditable="True"
                          ToolTip="Pick one or type your own" />
                <TextBlock Grid.Row="4" Text="Breed" Style="{StaticResource FormLabel}" />
                <TextBox Grid.Row="4" Grid.Column="1" x:Name="BreedBox" MaxLength="50" />
                <TextBlock Grid.Row="5" Text="Birth date" Style="{StaticResource FormLabel}" />
                <DatePicker Grid.Row="5" Grid.Column="1" x:Name="BirthDateBox" />
                <TextBlock Grid.Row="6" Text="Weight (kg)" Style="{StaticResource FormLabel}" />
                <TextBox Grid.Row="6" Grid.Column="1" x:Name="WeightBox" />
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="New" Click="New_Click" />
                <Button Content="Save" Click="Save_Click" Style="{DynamicResource AccentButtonStyle}"
                        Margin="0,0,8,0" MinWidth="90" />
                <Button x:Name="DeleteButton" Content="Delete" Click="Delete_Click" />
            </StackPanel>
            <TextBlock Margin="0,16,0,0" Style="{StaticResource Hint}"
                       Text="Deleting a pet also deletes its appointments." />
        </StackPanel>
    </Grid>
</UserControl>
