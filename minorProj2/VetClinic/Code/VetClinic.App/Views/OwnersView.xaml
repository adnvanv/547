<UserControl x:Class="VetClinic.App.Views.OwnersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <Grid Margin="8,16,8,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <!-- List + search -->
        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="Owners" Style="{StaticResource SectionHeader}" />

            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="SearchField" Grid.Column="0" Margin="0" VerticalAlignment="Center"
                          ToolTip="Column to search" />
                <TextBox x:Name="SearchBox" Grid.Column="2" Margin="0,0,8,0" VerticalAlignment="Center"
                         KeyDown="SearchBox_KeyDown" ToolTip="Text to find (partial matches allowed)" />
                <Button Grid.Column="3" Content="Search" Click="Search_Click" IsDefault="False" />
                <Button Grid.Column="4" Content="Clear" Click="ClearSearch_Click" Margin="0" />
            </Grid>

            <TextBlock x:Name="ResultCount" DockPanel.Dock="Bottom" Margin="0,6,0,0" Style="{StaticResource Hint}" />

            <DataGrid x:Name="Grid" SelectionChanged="Grid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding OwnerId}" Width="50" />
                    <DataGridTextColumn Header="First name" Binding="{Binding FirstName}" Width="*" />
                    <DataGridTextColumn Header="Last name" Binding="{Binding LastName}" Width="*" />
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="2*" />
                    <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="1.3*" />
                    <DataGridTextColumn Header="City" Binding="{Binding City}" Width="*" />
                    <DataGridTextColumn Header="Pets" Binding="{Binding PetCount}" Width="50" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- Detail form -->
        <StackPanel Grid.Column="2">
            <TextBlock x:Name="FormTitle" Text="New owner" Style="{StaticResource SectionHeader}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="ID" Style="{StaticResource FormLabel}" />
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="IdBox" IsReadOnly="True" Focusable="False"
                         Text="(assigned on save)" />
                <TextBlock Grid.Row="1" Text="First name *" Style="{StaticResource FormLabel}" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="FirstNameBox" MaxLength="50" />
                <TextBlock Grid.Row="2" Text="Last name *" Style="{StaticResource FormLabel}" />
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="LastNameBox" MaxLength="50" />
                <TextBlock Grid.Row="3" Text="Email" Style="{StaticResource FormLabel}" />
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="EmailBox" MaxLength="100" />
                <TextBlock Grid.Row="4" Text="Phone" Style="{StaticResource FormLabel}" />
                <TextBox Grid.Row="4" Grid.Column="1" x:Name="PhoneBox" MaxLength="25" />
                <TextBlock Grid.Row="5" Text="City" Style="{StaticResource FormLabel}" />
                <TextBox Grid.Row="5" Grid.Column="1" x:Name="CityBox" MaxLength="50" />
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="New" Click="New_Click" />
                <Button Content="Save" Click="Save_Click" Style="{DynamicResource AccentButtonStyle}"
                        Margin="0,0,8,0" MinWidth="90" />
                <Button x:Name="DeleteButton" Content="Delete" Click="Delete_Click" />
            </StackPanel>
            <TextBlock Margin="0,16,0,0" Style="{StaticResource Hint}"
                       Text="Deleting an owner also deletes their pets and those pets' appointments." />
        </StackPanel>
    </Grid>
</UserControl>
